# development locally, production on Render
NODE_ENV=development
PORT=5000

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URL=your_mongodb_connection_string

# Long random string; at least 32 characters in production
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=2d

# Sites allowed to call the API, comma separated. Required in production (your Vercel URL).
CORS_ORIGINS=http://localhost:5173

# Number of proxies in front of the API (Render = 1). Leave empty to use the default.
TRUST_PROXY=

# Forgot password works with just the email (no code is sent). Set false to turn it off.
ALLOW_PASSWORD_RESET_BY_EMAIL=true

# Supabase Storage (S3 connection). Create the bucket and make it public in the Supabase dashboard.
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=veo
STORAGE_REGION=
# Public base URL of stored files. Supabase: https://<project_ref>.supabase.co/storage/v1/object/public/<bucket>
STORAGE_PUBLIC_URL=
STORAGE_FORCE_PATH_STYLE=true

# Upload size limits in MB (keep VITE_MAX_IMAGE_MB / VITE_MAX_VIDEO_MB on the client the same)
MAX_IMAGE_MB=5
MAX_VIDEO_MB=200
