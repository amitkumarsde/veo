# development on this computer, production on Render
NODE_ENV=development
PORT=5000

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URL=your_mongodb_connection_string

# Long random text; at least 32 characters in production
JWT_SECRET=your_jwt_secret_key

# Proxies in front of the server in production (Render); /health shows the IP the server sees, which should be the caller's real IP
TRUST_PROXY_HOPS=1

# Sites allowed to call the API, comma separated; required in production (the Vercel URL)
CORS_ORIGINS=http://localhost:5173

# true lets anyone who knows an email set its password (no email is sent); keep false unless that is fine
ALLOW_PASSWORD_RESET_BY_EMAIL=false

# Supabase Storage over S3; create the bucket and make it public in the Supabase dashboard
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=veo
STORAGE_REGION=
# Public base URL of stored files, like https://<project_ref>.supabase.co/storage/v1/object/public/<bucket>
STORAGE_PUBLIC_URL=
STORAGE_FORCE_PATH_STYLE=true

# Upload size limits in MB; use the same values for VITE_MAX_IMAGE_MB and VITE_MAX_VIDEO_MB in the client
MAX_IMAGE_MB=5
MAX_VIDEO_MB=50
